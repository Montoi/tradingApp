# ─── Gemini (required) ────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Gemini model (optional) ──────────────────────────────────────────────────
# Default: gemini-1.5-flash (fast + cheap). Options: gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ─── Whisper (optional) ───────────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v3
# Recommendation: start with 'base', upgrade to 'small' if accuracy is low
WHISPER_MODEL_SIZE=base

# Language code: 'es' for Spanish, 'en' for English, leave empty for auto-detect
WHISPER_LANGUAGE=es

# Device: 'cpu' (default) | 'cuda' (requires NVIDIA GPU + CUDA toolkit)
WHISPER_DEVICE=cpu

# Compute type: 'int8' (fastest, CPU) | 'float16' (GPU) | 'float32' (slow/precise)
WHISPER_COMPUTE=int8

# ─── Performance (optional) ───────────────────────────────────────────────────
# Number of concurrent AI tasks (2 vision + 2 audio is a good default)
MAX_WORKERS=4

# Seconds the WAV file must be stable (unchanged size) before processing
WAV_STABLE_SECS=1.0
